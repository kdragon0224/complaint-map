# 복사해서 .env.local 로 만들고 값을 채운다 (.env.local 은 git에 올리지 않는다)

# 카카오 — 지도 JavaScript 키(브라우저 노출 가능, 도메인 제한 설정) / REST API 키(서버 전용)
NEXT_PUBLIC_KAKAO_MAP_KEY=
KAKAO_REST_API_KEY=

# Supabase — URL·anon 키는 브라우저 노출 가능, service role 키는 서버·스크립트 전용(절대 NEXT_PUBLIC_ 금지)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 한국도로공사 공공데이터 포털 (data.ex.co.kr) 인증키 — 데이터 갱신 스크립트용
EX_DATA_API_KEY=

# 관리자 비밀번호 (/stats, /feedback 삭제) — 서버 전용. NEXT_PUBLIC_ 접두사 금지
ADMIN_PASSWORD=
